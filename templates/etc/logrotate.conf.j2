{{ ansible_managed | comment }}
{#
  logrotate.conf.j2 — global logrotate configuration
  Fork of arillso/ansible.logrotate (https://github.com/arillso/ansible.logrotate)
  Maintained by Bob Tanner (fork taken over 2026-05-21)
#}

# see "man logrotate" for details
{% if logrotate_options | length > 0 %}
{% for option in logrotate_options %}
{{ option }}
{% endfor %}
{% else %}
{% for option in logrotate_distribution_options | default([]) %}
{{ option }}
{% endfor %}
{% endif %}

# packages drop log rotation information into this directory
include {{ logrotate_include_dir }}

# wtmp and btmp are rotated here only when no drop-in above already does
{% if __logrotate_render_wtmp | default(logrotate_wtmp_enable) | bool %}
{{ logrotate_wtmp.logs | join(" ") }} {
{% for option in logrotate_wtmp.options %}
    {{ option }}
{% endfor %}
}
{% endif %}

{% if __logrotate_render_btmp | default(logrotate_btmp_enable) | bool %}
{{ logrotate_btmp.logs | join(" ") }} {
{% for option in logrotate_btmp.options %}
    {{ option }}
{% endfor %}
}
{% endif %}

# system-specific logs may be configured here
